# Copy to .env and fill in for a production build. Vite only reads .env
# files from this directory (frontend/), not the backend's.

# Only needed when the backend is served from a different origin than the
# frontend. Unset, requests go to the same origin: in development Vite proxies
# /api to the backend on port 8000, and in production the backend serves the
# built frontend itself.
# VITE_API_BASE=https://your-backend.example.com
