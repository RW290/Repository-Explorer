# Copy to .env and fill in. Never commit the real .env.

# Required. Create/rotate at https://ollama.com/settings/keys (free tier,
# no card required).
OLLAMA_API_KEY=your_actual_key_here

# Optional. Overrides the default open-weight model (gpt-oss:20b) served via
# Ollama Cloud. Free-tier models as of writing: gemma4:31b, gpt-oss:120b,
# gpt-oss:20b, nemotron-3-nano:30b, nemotron-3-super, nemotron-3-ultra —
# gpt-oss:20b is the smallest, which stretches the GPU-time-based free quota
# furthest. Check ollama.com/models before changing.
# OLLAMA_MODEL=gpt-oss:20b

# Only needed when deploying (a hosted instance has no local `gh auth login`
# session to fall back on). A personal access token with public repo read
# access is enough. Locally, leave this unset — the backend uses your `gh`
# CLI session instead, so no token needs to exist on disk.
# GITHUB_TOKEN=

# Only needed when deploying. Comma-separated list of origins allowed to
# call this backend (your deployed frontend's URL). Defaults to
# http://localhost:5173 for local dev.
# CORS_ORIGINS=https://your-frontend.example.com
