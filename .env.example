# Copy to .env and fill in. Never commit the real .env.

# Required. Create/rotate at https://huggingface.co/settings/tokens
# (a read-access token is enough).
HF_TOKEN=your_actual_token_here

# Optional. Overrides the default open-weight model
# (meta-llama/Llama-3.1-8B-Instruct) served via Hugging Face's hosted
# Inference Providers. Not every model on HF is actually servable this way —
# see the comment above DEFAULT_MODEL in backend/app/llm.py before changing.
# HF_MODEL=meta-llama/Llama-3.1-8B-Instruct

# Only needed when deploying (a hosted instance has no local `gh auth login`
# session to fall back on). A personal access token with public repo read
# access is enough. Locally, leave this unset — the backend uses your `gh`
# CLI session instead, so no token needs to exist on disk.
# GITHUB_TOKEN=

# Only needed when deploying. Comma-separated list of origins allowed to
# call this backend (your deployed frontend's URL). Defaults to
# http://localhost:5173 for local dev.
# CORS_ORIGINS=https://your-frontend.example.com
